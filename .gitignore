.env
.env.local
node_modules/
.next/
.vscode
.vercel
.env*.local

# Generated by Next on dev and build, and rewritten with different paths by
# each, so tracking it means a dirty tree after either. Next's own guidance is
# to ignore it: node_modules/next/dist/docs/01-app/03-api-reference/05-config/02-typescript.md
next-env.d.ts

# tsc --incremental's cache
tsconfig.tsbuildinfo

# A global gitignore often hides .claude/ wholesale, which would leave the
# project's skills out of every commit. Track the skills, and keep the rest of
# the directory (settings.local.json is personal) ignored.
!.claude/
.claude/*
!.claude/skills/

# Rendered by scripts/buildImageVariants.mjs at build time
public/rendered/
modules/heroImageHashes.json
