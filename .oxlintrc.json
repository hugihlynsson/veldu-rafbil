{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y",
    "nextjs",
    "import",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/exhaustive-deps": "warn",
    "react/set-state-in-effect": "error",
    "jsx-a11y/no-autofocus": "off",
    "eslint/eqeqeq": "error",
    "eslint/prefer-const": "error",
    "eslint/no-var": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["components/**", "utils/**", "modules/**"],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          {
            "name": "Temporal",
            "message": "Browsers do not all ship Temporal yet: keep it to routes and scripts, and pass the browser a YYYY-MM-DD string"
          }
        ]
      }
    }
  ]
}
