{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y",
    "nextjs",
    "import",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/exhaustive-deps": "warn",
    "react/set-state-in-effect": "warn",
    "jsx-a11y/no-autofocus": "off",
    "eslint/eqeqeq": "error"
  },
  "env": {
    "builtin": true
  }
}
